# Copy to .env for local development. Never commit .env.
# Names only, no values. Keep in sync with the code that reads them.

# HTTP port of the application (optional, defaults to 8080)
PORT=

# Local PostgreSQL container (read by docker-compose.yml)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Datasource read by the application (Spring Boot). No defaults: the app will
# not start without these. For local dev point the URL at the compose database,
# e.g. jdbc:postgresql://localhost:5432/<POSTGRES_DB>.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Single-account login (Spring Security). No defaults: the app will not start
# without these. APP_AUTH_PASSWORD_HASH is a bcrypt hash, never a plain password.
# See docs/DEPLOY.md for how to generate the hash.
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD_HASH=

# Mark the session cookie Secure (HTTPS-only). Set to true in production (Railway
# serves over HTTPS); leave false for local HTTP development (optional, defaults
# to false).
APP_SESSION_COOKIE_SECURE=

# Opcjonalny adres API dla frontendu (odczytywany przez frontend/src/api/client.ts).
# Pusta wartosc oznacza ten sam origin, co w produkcji. Dla lokalnego dev mozna
# wskazac backend, np. http://localhost:8080.
VITE_API_BASE_URL=

# Opcje JVM dla obrazu produkcyjnego (odczytywane przez ENTRYPOINT w Dockerfile).
# Ograniczenie pamieci JVM, np. -XX:MaxRAMPercentage=75.0. Domyslna wartosc jest
# ustawiona w Dockerfile; tutaj mozna ja nadpisac przy wdrozeniu.
JAVA_OPTS=
